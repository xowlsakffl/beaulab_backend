APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PASSWORD_RESET_USER_URL=http://localhost:3000/password/reset
PASSWORD_RESET_BEAUTY_URL=http://localhost:3000/password/reset
PASSWORD_RESET_STAFF_URL=http://localhost:3000/password/reset
PASSWORD_RESET_MAIL_QUEUE_CONNECTION=redis
PASSWORD_RESET_MAIL_QUEUE=mail
HOSPITAL_ACCOUNT_INVITATION_URL=http://localhost:3002/account/create
HOSPITAL_ACCOUNT_INVITATION_EXPIRE_HOURS=72
HOSPITAL_ACCOUNT_IDENTITY_VERIFICATION_TTL_MINUTES=15
HOSPITAL_ACCOUNT_INVITATION_MAIL_QUEUE_CONNECTION=redis
HOSPITAL_ACCOUNT_INVITATION_MAIL_QUEUE=mail
STAFF_LOGIN_SESSION_TOKEN_EXPIRE_MINUTES=720
STAFF_LOGIN_REMEMBER_TOKEN_EXPIRE_MINUTES=43200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
INTERNAL_TOOL_ALLOWED_IPS=127.0.0.1,::1
INTERNAL_TOOL_ALLOWED_EMAILS=
INTERNAL_TOOL_API_DOCS_URL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=beaulab-local
REVERB_APP_KEY=beaulab-local-key
REVERB_APP_SECRET=beaulab-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

SMS_ENABLED=false
SMS_PROVIDER=log
SMS_QUEUE=sms
SMS_MAX_BYTES=90
LMS_MAX_BYTES=2000

PUSH_ENABLED=false
PUSH_PROVIDER=fcm
PUSH_IOS_PROVIDER=fcm
PUSH_ANDROID_PROVIDER=fcm
PUSH_WEB_PROVIDER=fcm
PUSH_QUEUE=notifications
PUSH_HTTP_TIMEOUT=10

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=

APNS_ENABLED=false
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=

CACHE_STORE=redis
STAFF_SUMMARY_CACHE_STORE=redis
STAFF_SUMMARY_CACHE_TTL=300
HOSPITAL_EVENT_AD_CALENDAR_CACHE_STORE=redis
HOSPITAL_EVENT_AD_CALENDAR_CACHE_TTL=60
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEDIA_DISK=public
MEDIA_CACHE_CONTROL="public, max-age=31536000, immutable"

VITE_APP_NAME="${APP_NAME}"
