# Frontend developer's own local backend. Copy only into a NEW checkout without .env.
APP_NAME=BeaulabFrontendLocal
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beaulab_frontend_local
DB_USERNAME=beaulab_frontend
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=10
REDIS_CACHE_DB=11
REDIS_PREFIX=beaulab-frontend-local:
CACHE_STORE=redis
CACHE_PREFIX=beaulab-frontend-local-cache:
SESSION_DRIVER=redis
WEB_SESSION_CONNECTION=default
WEB_SESSION_REVOCATION_STORE=redis
QUEUE_CONNECTION=redis
HORIZON_PREFIX=beaulab-frontend-local-horizon:

STAFF_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USER_WEB_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
HOSPITAL_WEB_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
PASSWORD_RESET_STAFF_URL=http://localhost:3000/password/reset
PASSWORD_RESET_HOSPITAL_URL=http://localhost:3002/password/reset
HOSPITAL_ACCOUNT_INVITATION_URL=http://localhost:3002/account/create
# User reset screen is not implemented yet. Set its real URL when implementing it.
PASSWORD_RESET_USER_URL=
PASSWORD_RESET_MAIL_QUEUE_CONNECTION=redis
PASSWORD_RESET_MAIL_QUEUE=mail
HOSPITAL_ACCOUNT_INVITATION_MAIL_QUEUE_CONNECTION=redis
HOSPITAL_ACCOUNT_INVITATION_MAIL_QUEUE=mail

# No external email by default. To inspect mail, explicitly configure local Mailpit.
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=local@frontend.test
MAIL_FROM_NAME=BeaulabLocal
SMS_ENABLED=false
SMS_PROVIDER=disabled
PUSH_ENABLED=false
FCM_ENABLED=false
APNS_ENABLED=false

# Log broadcasts until local Reverb is explicitly started/configured.
BROADCAST_CONNECTION=log
REVERB_APP_ID=frontend-local
REVERB_APP_KEY=frontend-local-public
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PRIVATE_DISK=private_media
LOG_CHANNEL=single
LOG_LEVEL=info
TELESCOPE_ENABLED=false
INTERNAL_TOOL_ALLOWED_IPS=127.0.0.1,::1

# Enable only for first seed on an empty dedicated local DB; turn off afterwards.
FRONTEND_SEED_ENABLED=false
FRONTEND_SEED_PASSWORD=

# 개별 샘플/전체 데모/기존 표시값 보정은 명시적으로 활성화합니다.
DEVELOPMENT_SEED_ENABLED=false
DEVELOPMENT_SEED_DATABASE=
