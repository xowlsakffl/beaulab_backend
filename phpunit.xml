<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="0123456789abcdef0123456789abcdef" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_DATABASE" value="beaulab_testing" force="true"/>
        <env name="REDIS_URL" value="" force="true"/>
        <env name="REDIS_PREFIX" value="beaulab-testing:" force="true"/>
        <env name="REDIS_DB" value="15" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="WEB_SESSION_REVOCATION_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="BROADCAST_CONNECTION" value="log" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="SMS_PROVIDER" value="disabled" force="true"/>
        <env name="PUSH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
